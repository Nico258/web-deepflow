# Copia este archivo a .env para desarrollo local. .env está en .gitignore.
# En producción estas variables se configuran en el hosting (Cloud Run / Render).

PORT=8080

# Local: el Postgres de docker-compose.yml.
# Supabase: el pooler en modo transacción (puerto 6543).
DATABASE_URL=postgres://deepflow:deepflow@localhost:5432/deepflow?sslmode=disable

# Opcional. En Supabase: el pooler en modo sesión (puerto 5432) para migraciones y pg_dump.
# Si se omite, cmd/migrate usa DATABASE_URL.
# MIGRATIONS_DATABASE_URL=

# Orígenes permitidos por CORS, separados por coma. Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Proxies de confianza delante de la API: 0 en local; en el hosting, verificar (specs/03 §5).
TRUSTED_PROXY_HOPS=0

# Solo desarrollo: fija «hoy» (fecha de Bogotá) para probar el bloqueo diario y las
# rachas sin esperar días reales. La API no arranca si DEV_TODAY está definida y
# APP_ENV no es development. Nunca en producción.
# APP_ENV=development
# DEV_TODAY=2026-11-16

# Solo para tests: habilita los de integración de internal/store. Cada test crea y
# borra su propio esquema; no toca public. Nunca apuntar a producción.
# (go test no lee este archivo: definir la variable en la terminal.)
# TEST_DATABASE_URL=postgres://deepflow:deepflow@localhost:5432/deepflow?sslmode=disable
